# Copy to .env and edit. Never commit .env.
DATABASE_URL=sqlite:///./aroha.db
# Production: postgresql+psycopg://user:pass@localhost:5432/aroha
SECRET_KEY=change-me-to-a-long-random-string
TOKEN_ENCRYPTION_KEY=
ACCESS_TOKEN_MINUTES=60
COOKIE_SECURE=false
CORS_ORIGINS=["http://localhost:3000"]
NEWS_FEEDS=["https://techcrunch.com/category/social/feed/","https://www.socialmediatoday.com/feeds/news/"]
# Meta / Instagram (fill after creating the Meta app)
META_APP_ID=
META_APP_SECRET=
META_REDIRECT_URI=http://localhost:8000/instagram/callback
